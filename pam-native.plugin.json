{
    "$schema": "vendor/pushinbr/pam-native/resources/pam-native.plugin.schema.json",
    "version": 1,
    "protocol": 1,
    "pamNative": {
        "minimum": "1.0.35",
        "maximumExclusive": "2.0.0"
    },
    "capabilities": {
        "required": [
            "runtime.modules.v1",
            "wire.binary.v1"
        ],
        "optional": []
    },
    "php": {
        "provider": "Pam\\Native\\Calls\\CallsPluginProvider"
    },
    "android": {
        "namespace": "dev.pam.calls",
        "minSdk": 26,
        "permissions": [
            "android.permission.CAMERA",
            "android.permission.RECORD_AUDIO",
            "android.permission.POST_NOTIFICATIONS",
            "android.permission.USE_FULL_SCREEN_INTENT",
            "android.permission.FOREGROUND_SERVICE",
            "android.permission.FOREGROUND_SERVICE_CAMERA",
            "android.permission.FOREGROUND_SERVICE_MICROPHONE",
            "android.permission.VIBRATE",
            "android.permission.WAKE_LOCK"
        ],
        "sourceDirs": [
            "android/src/main/kotlin"
        ],
        "resourceDirs": [
            "android/src/main/res"
        ],
        "manifest": "android/src/main/AndroidManifest.xml",
        "consumerRules": "android/consumer-rules.pro"
    },
    "ios": {
        "minimumVersion": "15.0",
        "sourceDirs": [
            "ios/Sources"
        ],
        "frameworks": [
            "CallKit",
            "PushKit",
            "AVFoundation"
        ],
        "entitlements": "ios/Calls.entitlements",
        "infoPlist": "ios/Info.plist"
    },
    "idl": "pam-native.idl.json",
    "modules": [
        {
            "name": "calls",
            "class": "dev.pam.calls.CallsModule",
            "iosClass": "CallsModule"
        }
    ],
    "views": []
}
